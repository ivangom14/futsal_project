# Futsito: una pasada de actualización incremental de los datos de la RFFM (`scripts/update_rffm.sh`).
# La lanzan futsito-update-weekday.timer (L-V 03:00) y futsito-update-weekend.timer (S-D cada hora), ambos en Europe/Madrid.
# Parámetros de TU servidor (ajústalos antes de instalar; ver README, «Actualización automática»):
#   /opt/futsito        -> directorio del repositorio (WorkingDirectory, ExecStart, ReadWritePaths)
#   futsito             -> usuario y grupo sin privilegios que ejecuta la actualización
#   /etc/futsito/update.env -> variables (DATABASE_URL y la autorización de red)
[Unit]
Description=Futsito: actualización incremental de datos RFFM (scripts/update_rffm.sh)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=futsito
Group=futsito
WorkingDirectory=/opt/futsito
EnvironmentFile=/etc/futsito/update.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/futsito/scripts/update_rffm.sh 900
# Tope duro: 900 peticiones a 1 cada 3 s son unos 45 min; así nunca alcanza a la pasada de la hora siguiente.
TimeoutStartSec=58min
# SIGTERM: termina el trabajo en curso y no toma otro; las escrituras son transaccionales e idempotentes.
KillSignal=SIGTERM
TimeoutStopSec=120
# Recursos: prioridad baja para no molestar a la API ni al chat.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=50%
MemoryMax=1G
# Endurecimiento: solo puede escribir en data/ y logs/ del proyecto.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/futsito/data /opt/futsito/logs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027
