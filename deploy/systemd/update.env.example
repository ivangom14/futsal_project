# Copia a /etc/futsito/update.env (propietario root, grupo futsito, permisos 0640). No subir al repositorio.
# Base de datos (la de docker compose del proyecto publica el puerto en localhost).
DATABASE_URL=postgresql+psycopg://futsal:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/futsal
# Segunda llave de la red real (la primera es --allow-network en el servicio). Sin ella no se hace ninguna petición.
FUTSAL_RFFM_NETWORK_AUTHORIZED=1
# Opcional: horas tras las que una ejecución `running` sin cerrar se marca como abandonada (por defecto 6).
# FUTSAL_RUN_ABANDON_HOURS=6
