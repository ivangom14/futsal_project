# Copia a .env (ignorado por Git) y ajusta. No subir contraseñas reales.
POSTGRES_DB=futsal
POSTGRES_USER=futsal
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://futsal:change-me@localhost:5432/futsal
API_BASE_URL=http://127.0.0.1:8000
# Fase 7 (agente): solo en .env local, nunca en el repo
ANTHROPIC_API_KEY=
# Proveedor: anthropic (def.) | gemini. Clave de Gemini: solo en .env local
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MODEL=claude-haiku-4-5-20251001
MAX_TOOL_CALLS=5
MAX_RESULT_ROWS=40
# Traza JSONL de cada ejecución del agente (vacío = desactivada). Nunca contiene claves.
AGENT_TRACE_FILE=data/agent/traces.jsonl
# Reintentos del cliente LLM (solo 429, 5xx y errores de red; nunca 4xx permanentes). 0 = desactivados.
LLM_MAX_RETRIES=2
# Espera máxima (segundos) por reintento; si el servidor pide más con Retry-After, no se reintenta.
LLM_RETRY_MAX_WAIT=20
