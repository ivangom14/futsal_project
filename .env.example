# Copia a .env (ignorado por Git) y ajusta. No subir contraseñas reales.
POSTGRES_DB=futsal
POSTGRES_USER=futsal
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://futsal:change-me@localhost:5432/futsal
API_BASE_URL=http://127.0.0.1:8000
# Fase 7 (agente): solo en .env local, nunca en el repo
ANTHROPIC_API_KEY=
# Proveedor: gemini (referencia documentada) | anthropic (def. si no se define) | openai. Las claves, solo en .env local
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Modelo de Anthropic (si LLM_PROVIDER=anthropic)
LLM_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Modelo por tarea (router|interpreter|simple|complex|judge), formato proveedor:modelo; sin definir, se usa LLM_PROVIDER
# LLM_MODEL_SIMPLE=openai:gpt-6-luna
# LLM_MODEL_COMPLEX=anthropic:claude-sonnet-5-5
# Opcionales (sin definir, la petición queda como siempre)
# ANTHROPIC_PROMPT_CACHE=on
# GEMINI_THINKING_LEVEL=low
# OPENAI_REASONING_EFFORT=low
MAX_TOOL_CALLS=5
MAX_RESULT_ROWS=40
# Traza JSONL de cada ejecución del agente (vacío = desactivada). Nunca contiene claves.
AGENT_TRACE_FILE=data/agent/traces.jsonl
# Reintentos del cliente LLM (solo 429, 5xx y errores de red; nunca 4xx permanentes). 0 = desactivados.
LLM_MAX_RETRIES=2
# Espera máxima (segundos) por reintento; si el servidor pide más con Retry-After, no se reintenta.
LLM_RETRY_MAX_WAIT=20
# Comprensión conversacional (docs/phase-context-understanding.md): legacy (def., flujo de siempre) | deterministic (resolutor + estado + política, sin llamada extra)
# | llm (además, intérprete LLM solo cuando el resolutor duda). No activarlo al lanzar el A/B.
AGENT_CONTEXT=legacy
# Registro de preguntas reales del chat (un JSONL por día; solo fecha UTC y pregunta saneada). on | off (def.)
QUESTION_LOG=off
QUESTION_LOG_DIR=logs/questions
QUESTION_LOG_RETENTION_DAYS=30
QUESTION_LOG_MAX_CHARS=500
# Añade al registro la respuesta mostrada al usuario (saneada y recortada). Los ficheros crecen bastante más. on | off (def.)
QUESTION_LOG_ANSWERS=off
QUESTION_LOG_ANSWER_MAX_CHARS=2000

# Escudos oficiales en la interfaz (servicio de chat; docs/design-system/04-escudos-equipos.md):
#   off   = monogramas (por defecto)
#   local = copias propias normalizadas (WebP 96 px) servidas por el chat. Preparación:
#           python -m futsal.cli crest-backfill --dir data   (rutas desde las instantáneas, sin red)
#           python -m futsal.cli crest-download              (descarga 1 vez, 1 s entre peticiones)
#   link  = el navegador carga las imágenes de appweb.rffm.es (la RFFM ve la IP del visitante)
# Solo para pruebas privadas hasta tener autorización de la RFFM.
CRESTS_MODE=off
# Carpeta de las copias (la usan crest-download, la API y el chat)
CRESTS_DIR=data/crests
